POSTGRES_USER=ros
POSTGRES_DB=ros
POSTGRES_PASSWORD=replace-for-local-use
POSTGRES_PORT=55432
REDIS_PASSWORD=replace-for-local-use
REDIS_PORT=56379
# Local-only internal API token for dedicated game-server session lifecycle calls.
ROS_GAME_SERVER_TOKEN=replace-for-local-use
ROS_GAME_SERVER_ID=game-server-local
# Optional comma-separated dedicated-server assignment pool for the API.
ROS_GAME_SERVER_IDS=game-server-local
# Optional API trace export endpoint, for example http://otel-collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional signed recovery-delivery webhook. Leave unset to disable delivery
# until a reviewed provider is configured.
ROS_RECOVERY_WEBHOOK_URL=
ROS_RECOVERY_WEBHOOK_SECRET=
