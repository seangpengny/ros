FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

ARG TARGETOS=linux
ARG TARGETARCH=arm64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags='-s -w' -o /out/game-server ./cmd/game-server

FROM alpine:3.23

RUN addgroup -S ros && adduser -S -G ros ros
COPY --from=build /out/game-server /usr/local/bin/game-server

USER ros
EXPOSE 9000/udp 8080/tcp
ENTRYPOINT ["/usr/local/bin/game-server"]
